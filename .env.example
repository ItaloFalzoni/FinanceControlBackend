# FinanceControl API — example environment file.
# Copy to .env and adjust the values:  cp .env.example .env
# Docker Compose reads .env automatically for variable substitution.

# Production | Development (also drives appsettings.{Environment}.json).
# Default is Production so the OpenAPI document stays disabled unless you
# explicitly opt into Development for local debugging.
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL (used by docker-compose and by `dotnet run` via appsettings.Development.json)
POSTGRES_DB=financecontrol
POSTGRES_USER=financecontrol
POSTGRES_PASSWORD=dev-local-pg-password-change-me

# API key required by every /api/* route (the front sends it as X-Api-Key).
# docker compose passes it to the API as Authentication__ApiKey; the app does
# not start without it (fail-closed). Use a long random value in production.
API_KEY=dev-local-api-key-change-me
