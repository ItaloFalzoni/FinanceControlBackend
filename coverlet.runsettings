<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!--
            Source-generated code is not ours to cover: the OpenAPI generator
            emits support types under Microsoft.AspNetCore.OpenApi.Generated.*
            and System.Runtime.CompilerServices.* (InterceptsLocationAttribute).
            The generated file has no on-disk source, so it only pollutes the
            report (and triggers ReportGenerator "file does not exist" warnings).
          -->
          <Exclude>[FinanceControl.API]Microsoft.AspNetCore.OpenApi.Generated.*,[FinanceControl.API]System.Runtime.CompilerServices.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
